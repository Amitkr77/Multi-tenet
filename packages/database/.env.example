# Used by `prisma migrate`/`prisma db seed` (packages/database). This is the
# migrator/owner Postgres role — a superuser that bypasses RLS entirely, which
# is exactly why the running app must NEVER use this connection string (see
# apps/api/.env.example's DATABASE_URL_APP instead).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/saas_platform?schema=public"
