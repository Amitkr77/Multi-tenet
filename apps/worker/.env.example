REDIS_HOST=localhost
REDIS_PORT=6379
NODE_ENV=development

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_IGNORE_TLS=true
EMAIL_FROM=no-reply@yourapp.local

# Phase 5 — DunningProcessor's own DB connection (see that file's comment).
DATABASE_URL_APP="postgresql://app_user:change_me_in_env@localhost:5432/saas_platform?schema=public"
WEB_APP_URL=http://localhost:3000
DUNNING_GRACE_PERIOD_DAYS=3
DUNNING_CHECK_INTERVAL_MS=3600000

# Compliance — DataExportProcessor's own direct S3/MinIO client.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=saas-dev
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
DATA_RETENTION_DAYS=30
DATA_RETENTION_CHECK_INTERVAL_MS=86400000
