# The app connects as `app_user` (NOSUPERUSER NOBYPASSRLS) — RLS only actually
# enforces anything against a non-owner role. Never point this at the
# migrator/owner connection string in packages/database/.env.
DATABASE_URL_APP="postgresql://app_user:change_me_in_env@localhost:5432/saas_platform?schema=public"

NODE_ENV=development
PORT=3001

# Base domain tenants are resolved under: <subdomain>.<APP_BASE_DOMAIN>
APP_BASE_DOMAIN=yourapp.local
WEB_APP_URL=http://localhost:3000

REDIS_HOST=localhost
REDIS_PORT=6379

JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_IGNORE_TLS=true
EMAIL_FROM=no-reply@yourapp.local

# CORS
WEB_CORS_ORIGIN=http://localhost:3000

# Storage — MinIO in dev (docker-compose.yml), real S3 in production (same
# S3-compatible client either way, per arch.md)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=saas-dev
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_PUBLIC_URL_BASE=http://localhost:9000/saas-dev

# Storefront customer JWT — deliberately separate secret from staff JWT_ACCESS_SECRET
# so a leaked customer token can never be replayed as a staff token or vice versa
CUSTOMER_JWT_SECRET=dev-customer-secret-change-me

# Exactly 32 bytes encoded as 64 hexadecimal characters. Generate with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
TOTP_ENCRYPTION_KEY=

# Stripe — StripeService runs in stub mode whenever STRIPE_SECRET_KEY is
# unset (see stripe.service.ts), making real Stripe calls a pure env-var
# change away.
# STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_dev_placeholder_change_me
PLATFORM_APPLICATION_FEE_PERCENT=10

# Phase 5 — dunning (must match apps/worker/.env.example's own copy).
DUNNING_GRACE_PERIOD_DAYS=3
