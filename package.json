{
  "name": "saas-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "db:migrate": "pnpm --filter @saas/database exec prisma migrate dev",
    "db:migrate:deploy": "pnpm --filter @saas/database exec prisma migrate deploy",
    "db:generate": "pnpm --filter @saas/database exec prisma generate",
    "db:seed": "pnpm --filter @saas/database exec prisma db seed",
    "db:studio": "pnpm --filter @saas/database exec prisma studio"
  },
  "devDependencies": {
    "autocannon": "^8.0.0",
    "turbo": "^2.3.0",
    "typescript": "^5.6.0"
  }
}
